      </div>
      <div class="menu-actions">
       <button class="primary" id="start" type="button">
        JOGAR
       </button>
       <button hidden="" id="resume" type="button">
        Continuar
       </button>
      </div>
      <div class="record" id="record">
       Recorde local: 0
      </div>
     </section>
    </div>
   </div>
   <div class="controls">
    <div aria-label="Movimento" class="pad">
     <span>
     </span>
     <button aria-label="Avançar" data-key="w">
      ▲
     </button>
     <span>
     </span>
