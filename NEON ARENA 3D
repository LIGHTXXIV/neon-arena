  <style>
 :root {
  color-scheme: dark;
  --bg: #070c15;
  --panel: #101c2a;
  --ink: #edf8ff;
  --muted: #9ab0c5;
  --accent: #62f5d7;
  --line: #294357;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: system-ui, sans-serif;
}
button, select {
  font: inherit;
  color: inherit;
}
button {
  cursor: pointer;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #162b3b;
  padding: 10px 14px;
  font-weight: 700;
  touch-action: none;
}
button:hover, button:focus-visible {
  border-color: var(--accent);
}
button:active {
  transform: scale(.97);
}
button.primary {
  background: var(--accent);
  color: #052c26;
  border: 0;
}
button:disabled {
  opacity: .45;
  cursor: default;
}
main {
  max-width: 1160px;
  padding: 14px;
  margin: auto;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
h1 {
  margin: 0;
  font-size: clamp(19px, 4vw, 28px);
  letter-spacing: .09em;
  color: var(--accent);
}
.subtitle, .hint {
  color: var(--muted);
  font-size: 13px;
}
.stage {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #0b1726;
  min-height: 300px;
}
#game {
  display: block;
  width: 100%;
  height: clamp(320px, 61vh, 680px);
  touch-action: none;
  outline: none;
}
.hud {
  position: absolute;
  inset: 10px 10px auto;
  display: grid;
  grid-template-columns: repeat(5, minmax(0,1fr));
  gap: 6px;
  pointer-events: none;
}
.stat {
  background: #071320df;
  border: 1px solid #345365;
  border-radius: 8px;
  padding: 8px;
  text-align: center;
}
.stat small {
  display: block;
  font-size: 10px;
  color: var(--muted);
  letter-spacing: .06em;
}
.stat strong {
  font-size: clamp(13px, 2.5vw, 22px);
  font-variant-numeric: tabular-nums;
}
.bar {
  height: 4px;
  margin: 4px auto 0;
  background: #243141;
  border-radius: 3px;
  overflow: hidden;
}
.bar i {
  display: block;
  height: 100%;
  width: 100%;
  background: var(--accent);
  transition: width .15s;
}
.reticle {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 24px;
  height: 24px;
  transform: translate(-50%,-50%);
  pointer-events: none;
}
.reticle:before, .reticle:after {
  content: '';
  position: absolute;
  background: #e5fbff;
  box-shadow: 0 0 4px #000;
}
.reticle:before {
  left: 11px;
  top: 0;
  width: 2px;
  height: 24px;
}
.reticle:after {
  top: 11px;
  left: 0;
  height: 2px;
  width: 24px;
}
.reticle.hit {
  transform: translate(-50%,-50%) rotate(45deg);
}
.reticle.hit:before, .reticle.hit:after {
  background: #ffdb62;
}
.vignette {
  pointer-events: none;
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 90px #03081180;
}
.damage {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: radial-gradient(transparent 35%, #ff334a99);
  opacity: 0;
}
.toast {
  position: absolute;
  top: 23%;
  left: 50%;
  transform: translateX(-50%);
  color: #efffff;
  text-shadow: 0 2px 5px #000;
  pointer-events: none;
  text-align: center;
  font-weight: 800;
  width: 90%;
}
.feed {
  position: absolute;
  right: 10px;
  bottom: 12px;
  color: #d7ecfa;
  font-size: 12px;
  text-align: right;
  pointer-events: none;
}
.weapon-label {
  position: absolute;
  bottom: 12px;
  left: 12px;
  font-weight: 700;
  text-shadow: 0 2px 4px #000;
  pointer-events: none;
}
.overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: #040a15bf;
  padding: 14px;
  overflow-y: auto;
}
.overlay[hidden] {
  display: none;
}
.panel {
  width: min(100%, 430px);
  border: 1px solid #38586b;
  border-radius: 15px;
  background: #0f1d2bf5;
  padding: 18px;
  text-align: center;
}
.panel h2 {
  color: var(--accent);
  font-size: clamp(22px, 4vw, 34px);
  margin: 0 0 5px;
}
.panel p {
  color: #c4d5e5;
  margin: 8px 0 14px;
  font-size: 14px;
}
.settings {
  display: grid;
  gap: 8px;
  margin: 13px 0;
  text-align: left;
}
.settings label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  color: #c9d9e6;
  font-size: 13px;
}
select {
  min-width: 110px;
  background: #142838;
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 6px;
}
.menu-actions {
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
}
.controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
}
.pad {
  display: grid;
  grid-template-columns: repeat(3, 45px);
  grid-template-rows: repeat(2, 40px);
  gap: 4px;
}
.pad button {
  padding: 0;
  font-size: 17px;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 5px;
}
.hint {
  line-height: 1.6;
}
.record {
  color: var(--muted);
  font-size: 13px;
  margin-top: 9px;
}
@media (max-width: 600px) {
  main {
    padding: 7px;
  }
  .hud {
    inset: 5px 5px auto;
    gap: 3px;
  }
  .stat {
    padding: 5px 2px;
  }
  .stat small {
    font-size: 8px;
  }
  .pad {
    grid-template-columns: repeat(3, 36px);
    grid-template-rows: repeat(2,36px);
  }
  .actions button {
    padding: 9px 7px;
    font-size: 11px;
  }
  .panel {
    padding: 12px;
  }
  .panel p {
    font-size: 12px;
  }
  .feed {
    max-width: 45%;
  }
}
@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
  }
}
#radar {
  position: absolute;
  right: 12px;
  top: 80px;
  width: 92px;
  height: 92px;
  border: 1px solid #486878;
  border-radius: 8px;
  opacity: .9;
  pointer-events: none;
}
#compass {
  position: absolute;
  top: 78px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: #b7e5e8;
  text-shadow: 0 2px 4px #000;
  pointer-events: none;
}
#remaining {
  position: absolute;
  left: 12px;
  top: 79px;
  color: #c2d8e4;
  font-size: 11px;
  pointer-events: none;
  text-shadow: 0 2px 3px #000;
}
[hidden] {
  display: none !important;
}
.header-buttons {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
}
.report {
  margin-top: 16px;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
}
.report summary {
  cursor: pointer;
  color: var(--muted);
  font-weight: 700;
}
#sessionReport {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(130px,1fr));
  gap: 12px;
  padding: 12px 2px 2px;
}
#sessionReport div {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
#sessionReport span {
  font-size: 12px;
  color: var(--muted);
}
#sessionReport strong {
  color: var(--accent);
  font-size: 19px;
}
.stage:fullscreen {
  width:100%;
  height:100%;
  border:0;
  border-radius:0;
}
.stage:fullscreen #game {
  height:100%;
}
@media (max-width:600px) {
  #radar {
    top: 58px;
    right: 6px;
    width:64px;
    height:64px;
  }
  #compass, #remaining {
    top:58px;
    font-size:9px;
  }
  #remaining {
    left:6px;
  }
  .header-buttons button {
    font-size:11px;
    padding:7px;
  }
}
  </style>
 </head>
