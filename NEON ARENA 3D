    const turn = (keys.has('arrowright') ? 1 : 0) - (keys.has('arrowleft') ? 1 : 0);
    const look = (keys.has('arrowup') ? 1 : 0) - (keys.has('arrowdown') ? 1 : 0);
    player.yaw += turn * dt * 1.8;
    player.pitch = clamp(player.pitch + look * dt * 1.25, -1.1, 1.1);
    const f = (keys.has('w') ? 1 : 0) - (keys.has('s') ? 1 : 0);
    const side = (keys.has('d') ? 1 : 0) - (keys.has('a') ? 1 : 0);
    const sprint = keys.has('shift');
    if (f || side) {
        const speed = (sprint ? 5.8 : 3.65) * dt / (Math.hypot(f, side) || 1);
        move(player, (Math.sin(player.yaw) * f + Math.cos(player.yaw) * side) * speed, (-Math.cos(player.yaw) * f + Math.sin(player.yaw) * side) * speed);
        player.bob += dt * (sprint ? 15 : 10);
    }
    else
        player.bob = lerp(player.bob, Math.round(player.bob / TAU) * TAU, Math.min(1, dt * 6));
    player.recoil = Math.max(0, player.recoil - dt * 5.4);
    player.invincible = Math.max(0, player.invincible - dt);
    state.cooldown = Math.max(0, state.cooldown - dt);
    if (state.reload > 0) {
        state.reload = Math.max(0, state.reload - dt);
        if (!state.reload) {
            mags[player.slot] = WEAPONS[player.slot].capacity;
            tone(310, .06, .035);
        }
    }
    if ((state.fireHeld || keys.has(' ')) && WEAPONS[player.slot].automatic)
        shoot();
}
function update(dt) {
    if (state.mode !== 'playing')
        return;
    state.elapsed += dt;
    state.clock += dt;
    state.flash = Math.max(0, state.flash - dt);
    state.hit = Math.max(0, state.hit - dt);
    state.damage = Math.max(0, state.damage - dt * 2.5);
    state.notice = Math.max(0, state.notice - dt);
    playerStep(dt);
    for (const e of enemies) {
        if (state.mode !== 'playing')
            break;
        enemyStep(e, dt);
    }
    if (state.mode !== 'playing')
        return;
    pickupStep(dt);
    effectStep(dt);
    waveStep(dt);
    updateHUD();
}
// Modelo articulado de robô em blocos. A posição local acompanha a rotação.
function robotPart(e, x, y, z, sx, sy, sz, tint, glow = 0) {
    const s = e.def.size, c = Math.cos(e.yaw), a = Math.sin(e.yaw);
    drawBox(e.x + (x * c + z * a) * s, y * s, e.z + (-x * a + z * c) * s, sx * s, sy * s, sz * s, tint, glow, e.yaw);
}
function drawRobot(e) {
    const body = e.hurt > 0 ? C.white : e.tint;
    const swing = Math.sin(e.phase) * .09;
    robotPart(e, 0, .035, 0, .82, .055, .7, C.black);
    robotPart(e, -.16, .32, swing, .23, .50, .24, C.gray);
    robotPart(e, .16, .32, -swing, .23, .50, .24, C.gray);
    robotPart(e, -.16, .11, .06 + swing, .25, .16, .35, C.metal);
    robotPart(e, .16, .11, .06 - swing, .25, .16, .35, C.metal);
    robotPart(e, 0, .91, 0, .62, .65, .40, body);
    robotPart(e, 0, .95, .22, .33, .30, .055, C.dark);
    robotPart(e, 0, .95, .26, .14, .14, .04, C.stripe, .85);
    robotPart(e, -.43, 1.02, 0, .19, .46, .23, C.metal);
    robotPart(e, .43, 1.02, 0, .19, .46, .23, C.metal);
    robotPart(e, 0, 1.54, 0, .53, .40, .42, body);
    robotPart(e, 0, 1.54, .225, .45, .18, .055, C.black);
    robotPart(e, -.12, 1.54, .26, .11, .075, .03, C.red, 1);
    robotPart(e, .12, 1.54, .26, .11, .075, .03, C.red, 1);
    if (e.type === 'heavy') {
        robotPart(e, -.43, 1.26, 0, .31, .23, .35, C.purple);
        robotPart(e, .43, 1.26, 0, .31, .23, .35, C.purple);
    }
    if (e.type === 'guard' || e.type === 'heavy')
        robotPart(e, .43, 1.02, .26, .19, .20, .39, C.black);
    if (e.hurt > 0) {
        const fraction = clamp(e.hp / e.def.hp, 0, 1);
        robotPart(e, 0, 1.88, 0, .62, .06, .04, C.dark);
        robotPart(e, -.31 + .31 * fraction, 1.88, .02, .62 * fraction, .045, .035, C.green, .8);
    }
}
function drawPickup(p) {
    const height = .32 + Math.sin(p.phase) * .10;
    const tint = p.kind === 'health' ? C.green : C.gold;
    drawBox(p.x, .025, p.z, .62, .04, .62, C.dark);
    drawBox(p.x, height, p.z, .42, .42, .42, tint, .6, p.phase);
    if (p.kind === 'health') {
        drawBox(p.x, height + .24, p.z, .24, .04, .075, C.white, .6, p.phase);
        drawBox(p.x, height + .24, p.z, .075, .04, .24, C.white, .6, p.phase);
    }
    else
        drawBox(p.x, height + .24, p.z, .20, .05, .20, C.white, .6, p.phase);
}
function drawEffect(e) {
    const size = .045 + e.left * .065;
    drawBox(e.x, e.y, e.z, size, size, size, e.tint, .9);
}
// A arma em primeira pessoa usa uma segunda câmera; nunca atravessa o cenário.
function drawWeapon(projection) {
    gl.clear(gl.DEPTH_BUFFER_BIT);
    camera(projection, [0, 0, 0], 0);
    const w = WEAPONS[player.slot];
    const x = .29 + Math.sin(player.bob) * .014;
    const y = -.30 - Math.sin(player.bob) * .012 - (state.reload > 0 ? .18 : 0) - player.recoil * .025;
    const z = -.58 + player.recoil * .075;
    const l = w.size;
    const tint = color(w.tint);
    drawBox(x, y, z, .16, .13, .34 * l, C.black);
    drawBox(x, y + .055, z - .09, .135, .10, .43 * l, tint);
    drawBox(x, y + .063, z - .29 * l, .075, .072, .24 * l, C.dark);
    drawBox(x, y + .075, z - .43 * l, .09, .09, .07, C.metal);
    drawBox(x, y - .09, z + .06, .09, .19, .105, C.gray);
    drawBox(x, y + .11, z - .01, .043, .052, .08, C.black);
    drawBox(x, y + .127, z - .01, .025, .012, .035, C.stripe, .9);
    drawBox(x + .073, y + .02, z - .08, .012, .028, .13, C.stripe, .75);
    if (player.slot === 1)
        drawBox(x, y - .10, z - .07, .10, .19, .12, C.dark);
    if (player.slot === 2)
        drawBox(x, y + .065, z - .26, .13, .09, .32, C.metal);
    drawBox(x + .10, y - .13, z + .11, .14, .13, .23, C.metal);
    if (state.flash > 0) {
        drawBox(x, y + .07, z - .49 * l, .11, .11, .13, C.gold, 1);
        drawBox(x, y + .07, z - .56 * l, .045, .045, .12, C.white, 1);
    }
}
function render() {
    resize();
    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
    const projection = perspective(PI / 2.8, canvas.width / Math.max(1, canvas.height), .05, 100);
    const eye = [player.x, eyeHeight(), player.z];
    const vp = multiply(projection, viewMatrix(eye, forward()));
    camera(vp, eye, .023);
    drawWorld();
    for (const e of enemies)
        drawRobot(e);
    for (const p of pickups)
        drawPickup(p);
    for (const effect of effects)
        drawEffect(effect);
    drawWeapon(projection);
}
function loop(now) {
    const dt = Math.min(.045, (now - previous) / 1000 || 0);
    previous = now;
    update(dt);
    render();
    updateTelemetry();
    requestAnimationFrame(loop);
}
const keyboard = ['w', 'a', 's', 'd', 'arrowleft', 'arrowright', 'arrowup', 'arrowdown', ' ', 'shift', 'r', '1', '2', '3', 'p', 'escape'];
window.addEventListener('keydown', e => {
    const k = e.key.toLowerCase();
    if (!keyboard.includes(k))
        return;
    if (k === 'p' && state.mode === 'paused') {
        e.preventDefault();
        resume();
        return;
    }
    if (state.mode !== 'playing')
        return;
    e.preventDefault();
    keys.add(k);
    if (e.repeat)
        return;
    if (k === 'r')
        reloadWeapon();
    if (k === ' ')
        shoot();
    if (['1', '2', '3'].includes(k))
        chooseWeapon(Number(k) - 1);
    if (k === 'p' || k === 'escape')
        pause();
});
window.addEventListener('keyup', e => keys.delete(e.key.toLowerCase()));
window.addEventListener('blur', clearInput);
document.addEventListener('visibilitychange', () => { if (document.hidden && state.mode === 'playing')
    pause(); });
function turn(dx, dy, factor) {
    const sensitivity = Number($('sensitivity').value) / 4;
    player.yaw += dx * factor * sensitivity;
    player.pitch = clamp(player.pitch - dy * factor * sensitivity, -1.1, 1.1);
}
canvas.addEventListener('pointerdown', e => {
    if (state.mode !== 'playing')
        return;
    initAudio();
    if (e.pointerType === 'mouse') {
        if (document.pointerLockElement === canvas) {
            state.fireHeld = true;
            shoot();
        }
        else {
            try {
                const req = canvas.requestPointerLock?.();
                req?.catch?.(() => { });
            }
            catch (_) { }
            drag = { id: e.pointerId, x: e.clientX, y: e.clientY };
            canvas.setPointerCapture?.(e.pointerId);
        }
    }
    else {
        drag = { id: e.pointerId, x: e.clientX, y: e.clientY };
        canvas.setPointerCapture?.(e.pointerId);
    }
});
canvas.addEventListener('pointermove', e => {
    if (state.mode !== 'playing' || document.pointerLockElement === canvas || drag?.id !== e.pointerId)
        return;
    turn(e.clientX - drag.x, e.clientY - drag.y, .006);
    drag.x = e.clientX;
    drag.y = e.clientY;
});
document.addEventListener('mousemove', e => { if (state.mode === 'playing' && document.pointerLockElement === canvas)
    turn(e.movementX, e.movementY, .0025); });
document.addEventListener('pointerlockchange', () => { drag = null; state.fireHeld = false; });
window.addEventListener('pointerup', e => { state.fireHeld = false; if (drag?.id === e.pointerId)
    drag = null; });
window.addEventListener('pointercancel', clearInput);
for (const button of document.querySelectorAll('[data-key]')) {
    const k = button.dataset.key;
    button.addEventListener('pointerdown', e => { if (state.mode !== 'playing')
        return; e.preventDefault(); button.setPointerCapture(e.pointerId); keys.add(k); });
    for (const event of ['pointerup', 'pointercancel', 'lostpointercapture'])
        button.addEventListener(event, () => keys.delete(k));
}
$('fire').addEventListener('pointerdown', e => { e.preventDefault(); if (state.mode !== 'playing')
    return; $('fire').setPointerCapture(e.pointerId); state.fireHeld = true; shoot(); });
for (const event of ['pointerup', 'pointercancel', 'lostpointercapture'])
    $('fire').addEventListener(event, () => state.fireHeld = false);
$('reload').onclick = reloadWeapon;
$('switch').onclick = () => chooseWeapon((player.slot + 1) % WEAPONS.length);
$('start').onclick = start;
$('resume').onclick = resume;
$('pause').onclick = () => { if (state.mode === 'playing')
    pause();
else if (state.mode === 'paused')
    resume(); };
$('sound').onchange = () => { if ($('sound').checked)
    initAudio(); };
canvas.addEventListener('contextmenu', e => e.preventDefault());
canvas.addEventListener('webglcontextlost', e => { e.preventDefault(); state.mode = 'menu'; clearInput(); $('overlay').hidden = false; $('menuTitle').textContent = 'GRÁFICOS INTERROMPIDOS'; $('menuText').textContent = 'Recarregue a página para reiniciar o motor 3D.'; $('start').disabled = true; });
function boot() {
    if (!gl) {
        $('menuText').textContent = 'Seu navegador não oferece WebGL. Ative a aceleração gráfica ou tente outro navegador.';
        $('start').disabled = true;
        return;
    }
    try {
        renderer = initRenderer();
        makeWorld();
        updateHUD();
        requestAnimationFrame(loop);
    }
    catch (error) {
        console.error(error);
        $('menuText').textContent = 'Não foi possível iniciar os gráficos 3D neste navegador.';
        $('start').disabled = true;
    }
}
// Radar de navegação e bússola: informações auxiliares, sem alterar a física.
const radar = $('radar');
const radarCtx = radar.getContext('2d');
const prefs = {
    map: 0,
    difficulty: 'normal',
    sound: true,
    sensitivity: 4,
    radar: true,
    quality: 'auto'
};
const sessionStats = {
    seconds: 0,
    shots: 0,
    hits: 0,
    robots: 0,
    score: 0,
    wins: 0,
    matches: 0
};
function loadPreferences() {
    try {
        const stored = JSON.parse(localStorage.getItem('neon-arena-prefs-v2') || '{}');
        if (Number.isInteger(stored.map) && MAPS[stored.map])
            prefs.map = stored.map;
        if (Object.hasOwn(DIFFICULTIES, stored.difficulty))
            prefs.difficulty = stored.difficulty;
        if (typeof stored.sound === 'boolean')
            prefs.sound = stored.sound;
        if (Number.isFinite(stored.sensitivity))
            prefs.sensitivity = clamp(stored.sensitivity, 1, 10);
        if (typeof stored.radar === 'boolean')
            prefs.radar = stored.radar;
        if (['auto', 'low', 'high'].includes(stored.quality))
            prefs.quality = stored.quality;
    }
    catch (_) {
        // O jogo continua disponível mesmo quando o armazenamento é bloqueado.
    }
    $('map').value = prefs.map;
    $('difficulty').value = prefs.difficulty;
    $('sound').checked = prefs.sound;
    $('sensitivity').value = prefs.sensitivity;
    $('radarToggle').checked = prefs.radar;
    $('quality').value = prefs.quality;
}
function savePreferences() {
    prefs.map = Number($('map').value);
    prefs.difficulty = $('difficulty').value;
    prefs.sound = $('sound').checked;
    prefs.sensitivity = Number($('sensitivity').value);
    prefs.radar = $('radarToggle').checked;
    prefs.quality = $('quality').value;
    try {
        localStorage.setItem('neon-arena-prefs-v2', JSON.stringify(prefs));
    }
    catch (_) {
        // Preferências continuam válidas enquanto a aba estiver aberta.
    }
    syncRadarVisibility();
}
function syncRadarVisibility() {
    radar.hidden = !prefs.radar || state.mode !== 'playing';
}
function drawRadar() {
    if (!radarCtx || radar.hidden)
        return;
    const ctx = radarCtx;
    const span = radar.width;
    const unit = span / map.layout[0].length;
    const coordinate = n => n / TILE * unit;
    ctx.clearRect(0, 0, span, span);
    ctx.fillStyle = '#091625';
    ctx.fillRect(0, 0, span, span);
    for (let row = 0; row < map.layout.length; row++) {
        for (let col = 0; col < map.layout[row].length; col++) {
            if (map.layout[row][col] === '#') {
                ctx.fillStyle = '#385467';
                ctx.fillRect(col * unit, row * unit, unit, unit);
            }
        }
    }
    for (const p of pickups) {
        ctx.fillStyle = p.kind === 'health' ? '#54e5a4' : '#ffd375';
        ctx.fillRect(coordinate(p.x) - 2, coordinate(p.z) - 2, 4, 4);
    }
    for (const e of enemies) {
        // Radar de curto alcance: inimigos distantes não aparecem.
        if (distance(e, player) > 12)
            continue;
        ctx.beginPath();
        ctx.fillStyle = '#ff6077';
        ctx.arc(coordinate(e.x), coordinate(e.z), 2.5, 0, TAU);
        ctx.fill();
    }
    ctx.save();
    ctx.translate(coordinate(player.x), coordinate(player.z));
    ctx.rotate(player.yaw);
    ctx.fillStyle = '#62f5d7';
    ctx.beginPath();
    ctx.moveTo(0, -6);
    ctx.lineTo(4, 4);
    ctx.lineTo(0, 2);
    ctx.lineTo(-4, 4);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
}
function compassLabel() {
    const directions = ['N', 'NE', 'L', 'SE', 'S', 'SO', 'O', 'NO'];
    const degree = ((player.yaw * 180 / PI) % 360 + 360) % 360;
    const index = Math.round(degree / 45) % 8;
    return `${directions[index]} · ${Math.round(degree) % 360}°`;
}
function updateTelemetry() {
    syncRadarVisibility();
    $('compass').hidden = state.mode !== 'playing';
    $('compass').textContent = compassLabel();
    $('remaining').textContent = `Robôs restantes: ${enemies.length + state.queue.length}`;
    $('remaining').hidden = state.mode !== 'playing';
    drawRadar();
}
function summarizeMatch(win) {
    sessionStats.seconds += state.elapsed;
    sessionStats.shots += state.fired;
    sessionStats.hits += state.landed;
    sessionStats.robots += state.kills;
    sessionStats.score += state.score;
    sessionStats.matches++;
    if (win)
        sessionStats.wins++;
    updateSessionReport();
}
function updateSessionReport() {
    const percent = sessionStats.shots ? Math.round(sessionStats.hits / sessionStats.shots * 100) : 0;
    const values = [
        ['Partidas concluídas', sessionStats.matches],
        ['Vitórias', sessionStats.wins],
        ['Robôs abatidos', sessionStats.robots],
        ['Disparos', sessionStats.shots],
        ['Precisão', `${percent}%`],
        ['Pontos acumulados', sessionStats.score],
        ['Tempo em jogo', formatTime(sessionStats.seconds)]
    ];
    const report = $('sessionReport');
    report.replaceChildren();
    for (const [label, value] of values) {
        const group = document.createElement('div');
        const name = document.createElement('span');
        const number = document.createElement('strong');
        name.textContent = label;
        number.textContent = value;
        group.append(name, number);
        report.append(group);
    }
}
function toggleFullScreen() {
    const stage = $('stage');
    if (document.fullscreenElement) {
        document.exitFullscreen?.().catch(() => { });
        return;
    }
    if (stage.requestFullscreen) {
        stage.requestFullscreen().catch(() => notify('Tela cheia indisponível'));
    }
    else {
        notify('Tela cheia indisponível');
    }
}
for (const name of ['map', 'difficulty', 'sound', 'sensitivity', 'radarToggle', 'quality']) {
    $(name).addEventListener('change', savePreferences);
}
$('fullscreen').addEventListener('click', toggleFullScreen);
document.addEventListener('fullscreenchange', () => {
    $('fullscreen').textContent = document.fullscreenElement ? 'Sair da tela cheia' : 'Tela cheia';
});
loadPreferences();
updateSessionReport();
boot();
